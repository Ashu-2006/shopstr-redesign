# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# design references: not app code (Pinterest images are third-party; proposal is personal)
/Pinterest/
*.pdf

# local test / tooling artifacts
.playwright-mcp/

# screenshots and scratch images (verification captures, never app assets).
# Real app imagery lives in /Assets and /public, both still tracked.
*.jpeg
*.jpg
*.png
*.gif
*.webp
!/Assets/**
!/public/**
!/design/assets/**

# agent tooling and local skills: environment, not product
/.claude/
/.agents/
/skills-lock.json

# working notes: plans, specs, audits and drafts written while building.
# Ignore the CONTENTS, not the directory itself, so the un-ignore below works
# (git will not descend into an excluded directory to re-include a child).
/docs/*
!/docs/app-map.md
# Maintainer handoff docs: written to ship, not private notes.
!/docs/HANDOFF.md
!/docs/architecture.md
!/docs/data-hooks-contract.md
!/docs/design-decisions.md
!/docs/running-and-verifying.md

# dev playgrounds: internal review surfaces (/dev/*), not shipped product
/pages/dev/
